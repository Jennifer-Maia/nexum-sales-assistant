{
  "datasets": [
    {
      "name": "ds_sessions",
      "displayName": "Sessões de conversa (Gold)",
      "queryLines": [
        "SELECT session_id, message_count, question_count, products_consulted, \n",
        "quotes_created, approvals_requested, approvals_resolved, \n",
        "payments_simulated, documents_generated, errors \n",
        "FROM gold_conversation_audit"
      ]
    },
    {
      "name": "ds_funnel",
      "displayName": "Funil de vendas (Gold)",
      "queryLines": [
        "SELECT 'sessoes' AS etapa, 1 AS ordem, COUNT(*) AS total \n",
        "FROM gold_conversation_audit \n",
        "UNION ALL SELECT 'cotacoes', 2, COUNT(*) FROM gold_quote_summary \n",
        "UNION ALL SELECT 'aprovacoes', 3, COUNT(*) FROM gold_quote_summary \n",
        "WHERE approval_status = 'approved' \n",
        "UNION ALL SELECT 'pagamentos_simulados', 4, COUNT(*) FROM gold_quote_summary \n",
        "WHERE payment_status = 'simulated_success' \n",
        "UNION ALL SELECT 'documentos_simulados', 5, COUNT(*) FROM gold_quote_summary \n",
        "WHERE status = 'completed' \n",
        "ORDER BY ordem"
      ]
    },
    {
      "name": "ds_tool_calls",
      "displayName": "Chamadas de ferramenta (Gold)",
      "queryLines": [
        "SELECT session_id, tool_name, status, duration_ms, created_at \n",
        "FROM gold_agent_operations \n",
        "WHERE event_type = 'tool_call'"
      ]
    },
    {
      "name": "ds_agent_turns",
      "displayName": "Atividade do agente (Gold)",
      "queryLines": [
        "SELECT session_id, event_type, tool_name, status, duration_ms, \n",
        "input_tokens, output_tokens, model, cost_estimated, error_message, \n",
        "created_at, source \n",
        "FROM gold_agent_operations"
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Qualidade e segurança (Gold)",
      "queryLines": [
        "SELECT 'aprovacoes_pendentes' AS indicador, COUNT(*) AS total \n",
        "FROM gold_quote_summary WHERE approval_status = 'pending' \n",
        "UNION ALL SELECT 'rejeicoes', COUNT(*) FROM gold_quote_summary \n",
        "WHERE approval_status = 'rejected' \n",
        "UNION ALL SELECT 'recusas', COUNT(*) FROM gold_agent_operations \n",
        "WHERE event_type = 'refusal' \n",
        "UNION ALL SELECT 'bloqueios_ferramenta', COUNT(*) FROM gold_agent_operations \n",
        "WHERE event_type = 'tool_selection_blocked' \n",
        "UNION ALL SELECT 'falhas_validacao', COUNT(*) FROM gold_agent_operations \n",
        "WHERE status IN ('validation_error', 'data_error') \n",
        "UNION ALL SELECT 'erros_agente', COUNT(*) FROM gold_agent_operations \n",
        "WHERE event_type = 'agent_error' \n",
        "ORDER BY indicador"
      ]
    },
    {
      "name": "ds_cost",
      "displayName": "Custo por sessão (Gold)",
      "queryLines": [
        "SELECT session_id, \n",
        "COUNT(*) AS interacoes, \n",
        "COALESCE(SUM(input_tokens), 0) AS tokens_entrada, \n",
        "COALESCE(SUM(output_tokens), 0) AS tokens_saida, \n",
        "COALESCE(SUM(cost_estimated), 0) AS custo_estimado, \n",
        "MIN(created_at) AS primeira_interacao \n",
        "FROM gold_agent_operations \n",
        "WHERE event_type = 'turn' \n",
        "GROUP BY session_id \n",
        "ORDER BY session_id"
      ]
    },
    {
      "name": "ds_update",
      "displayName": "Atualização dos dados (Gold)",
      "queryLines": [
        "SELECT tabela, camada, registros, atualizado_em \n",
        "FROM gold_data_freshness \n",
        "ORDER BY tabela"
      ]
    }
  ],
